APP_NAME=Music Hot Analysis API
API_PREFIX=/api

# You can also use DATABASE_URL directly, for example:
# DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/music_hot_analysis?charset=utf8mb4
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=music_hot_analysis
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_password
MYSQL_CHARSET=utf8mb4

CRAWLER_TOP_N=100
CRAWLER_TIMEOUT_SECONDS=20
CRAWLER_RETRY_TIMES=2
CRAWLER_DELAY_SECONDS=0.8
CRAWLER_METRIC_CONCURRENCY=2
CRAWLER_METRIC_DELAY_SECONDS=0.8
CRAWLER_USER_AGENT=

# Optional authorized headers. Keep real values only in .env.
CRAWLER_COOKIE=
NETEASE_COOKIE=
QQ_COOKIE=
KUGOU_COOKIE=
NETEASE_AUTHORIZATION=
QQ_AUTHORIZATION=
KUGOU_AUTHORIZATION=

# Optional fallback metric endpoints. Use | to separate multiple URLs.
# Supported variables: {platform_song_id}, {song_id}, {song_name}, {artist_name},
# {song_url}, and URL-encoded variants like {song_name_q}, {artist_name_q}.
NETEASE_METRIC_URLS=
QQ_METRIC_URLS=
KUGOU_METRIC_URLS=

SCHEDULER_ENABLED=false
SCHEDULER_HOUR=2
SCHEDULER_MINUTE=0
SCHEDULER_TIMEZONE=Asia/Shanghai

AI_ENABLED=false
AI_API_BASE=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_SECONDS=45
